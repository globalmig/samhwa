// 연도 간 이월 로직의 핵심 테이블. carriedOverFromId 자기참조로 이월 체인 구성
model UnclaimedFee {
  id                        String   @id @default(uuid()) @db.UniqueIdentifier
  projectTermInstitutionId  String   @map("project_term_institution_id") @db.UniqueIdentifier
  fiscalYear                 Int      @map("fiscal_year")
  billedFee                   BigInt   @map("billed_fee")
  actuallyBilled               BigInt   @default(0) @map("actually_billed")
  unclaimedAmount               BigInt   @map("unclaimed_amount")
  carriedOverFromId              String?  @map("carried_over_from_id") @db.UniqueIdentifier
  carriedOverAmount               BigInt   @default(0) @map("carried_over_amount")
  cumulativeUnclaimed              BigInt   @map("cumulative_unclaimed")
  finalClaimAmount                  BigInt?  @map("final_claim_amount")
  status                             String   @default("UNCLAIMED") @db.NVarChar(20) // unclaimed_status
  createdAt                          DateTime @default(now()) @map("created_at") @db.DateTime2
  updatedAt                          DateTime @updatedAt @map("updated_at") @db.DateTime2

  projectTermInstitution ProjectTermInstitution @relation(fields: [projectTermInstitutionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carriedOverFrom          UnclaimedFee?          @relation("UnclaimedCarryOver", fields: [carriedOverFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carriedOverTo            UnclaimedFee[]         @relation("UnclaimedCarryOver")

  @@unique([projectTermInstitutionId, fiscalYear])
  @@index([projectTermInstitutionId], name: "idx_unclaimed_fees_pti_id")
  @@index([fiscalYear], name: "idx_unclaimed_fees_fiscal_year")
