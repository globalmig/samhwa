// 수수료 계산의 최종 결과 테이블
model TermFee {
  id                        String    @id @default(uuid()) @db.UniqueIdentifier
  projectTermInstitutionId  String    @unique @map("project_term_institution_id") @db.UniqueIdentifier
  feePolicyId               String    @map("fee_policy_id") @db.UniqueIdentifier
  projectBudget              BigInt    @map("project_budget")
  standardFee                BigInt    @map("standard_fee")
  appliedFee                 BigInt?   @map("applied_fee")
  billedFee                  BigInt?   @map("billed_fee")
  cumulativeFee               BigInt?   @map("cumulative_fee")
  isFeeExempt                 Boolean   @default(false) @map("is_fee_exempt")
  exemptionReason              String?   @map("exemption_reason") @db.NVarChar(Max)
  status                       String    @default("DRAFT") @db.NVarChar(20) // fee_status
  confirmedBy                  String?   @map("confirmed_by") @db.UniqueIdentifier
  confirmedAt                  DateTime? @map("confirmed_at") @db.DateTime2
  notes                        String?   @db.NVarChar(Max)
